{
  "name": "@flessan/8.css",
  "version": "0.2.0",
  "description": "A CSS-only Windows 8 Modern UI library with flat components and locally bundled Font Awesome 4.7.0 icons.",
  "license": "MIT",
  "author": "Flessan",
  "type": "module",
  "main": "./dist/8.css",
  "style": "./dist/8.css",
  "exports": {
    ".": "./dist/8.css",
    "./dist/8.css": "./dist/8.css",
    "./dist/font-awesome/*": "./dist/font-awesome/*",
    "./dist/wallpapers/*": "./dist/wallpapers/*",
    "./font-awesome/*": "./dist/font-awesome/*",
    "./dist/gui/*": "./dist/gui/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/8.css",
    "dist/gui/",
    "dist/font-awesome/",
    "dist/wallpapers/",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node scripts/check-css.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flessan/8.css.git"
  },
  "homepage": "https://flessan.github.io/8.css/",
  "bugs": {
    "url": "https://github.com/flessan/8.css/issues"
  },
  "keywords": [
    "css",
    "windows-8",
    "modern-ui",
    "metro-ui",
    "css-framework",
    "design-system",
    "ui-library",
    "windows-8-icons",
    "font-awesome",
    "font-icons"
  ]
}
